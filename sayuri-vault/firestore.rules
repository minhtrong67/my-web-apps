rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Chỉ các email Google bên dưới được đọc/ghi. Thay REPLACE_WITH_YOUR_EMAIL trước khi deploy rules.
    function allowed() {
      return request.auth != null
        && request.auth.token.email_verified == true
        && request.auth.token.email in ['REPLACE_WITH_YOUR_EMAIL@gmail.com'];
    }
    match /{document=**} { allow read, write: if allowed(); }
  }
}
